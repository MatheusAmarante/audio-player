<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0d1117"
    android:fitsSystemWindows="true">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/full_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:padding="8dp"
            app:tint="#c9d1d9" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Artwork placeholder -->
    <FrameLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/album_art_placeholder">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="♪"
            android:textSize="64sp"
            android:textColor="#1e40af" />
    </FrameLayout>

    <!-- Track info -->
    <TextView
        android:id="@+id/full_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No track"
        android:textColor="#c9d1d9"
        android:textSize="20sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="32dp"
        android:paddingEnd="32dp" />

    <TextView
        android:id="@+id/full_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unknown"
        android:textColor="#8b8b9e"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp" />

    <!-- SeekBar -->
    <SeekBar
        android:id="@+id/full_seekbar"
        style="@style/Widget.AppCompat.SeekBar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:max="100"
        android:progressTint="#1e40af"
        android:thumbTint="#1e40af"
        android:progressBackgroundTint="#30363d"
        android:layout_marginTop="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp" />

    <!-- Time row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/full_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#8b8b9e"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/full_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#8b8b9e"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Main controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <ImageButton
            android:id="@+id/full_shuffle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:padding="8dp"
            app:tint="#8b8b9e" />

        <ImageButton
            android:id="@+id/full_prev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:padding="10dp"
            app:tint="#c9d1d9" />

        <ImageButton
            android:id="@+id/full_play_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_media_play"
            android:background="@drawable/play_btn_bg"
            android:scaleType="fitCenter"
            android:padding="12dp"
            app:tint="#ffffff" />

        <ImageButton
            android:id="@+id/full_next"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@android:drawable/ic_media_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:padding="10dp"
            app:tint="#c9d1d9" />

        <ImageButton
            android:id="@+id/full_repeat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_popup_sync"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:padding="8dp"
            app:tint="#8b8b9e" />
    </LinearLayout>

    <!-- Speed + Sleep row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <ImageButton
            android:id="@+id/full_btn_speed"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_media_ff"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:padding="4dp"
            app:tint="#8b8b9e" />

        <TextView
            android:id="@+id/full_speed_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.00x"
            android:textColor="#8b8b9e"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/full_sleep_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#1e40af"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Speed panel -->
    <LinearLayout
        android:id="@+id/full_speed_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <TextView android:id="@+id/full_speed_05" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0.5x" android:textColor="#8b8b9e" android:textSize="12sp"
            android:padding="8dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/full_speed_075" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0.75x" android:textColor="#8b8b9e" android:textSize="12sp"
            android:padding="8dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/full_speed_1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="1x" android:textColor="#1e40af" android:textSize="12sp"
            android:padding="8dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/full_speed_125" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="1.25x" android:textColor="#8b8b9e" android:textSize="12sp"
            android:padding="8dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/full_speed_15" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="1.5x" android:textColor="#8b8b9e" android:textSize="12sp"
            android:padding="8dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/full_speed_2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="2x" android:textColor="#8b8b9e" android:textSize="12sp"
            android:padding="8dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <!-- Sleep panel -->
    <LinearLayout
        android:id="@+id/full_sleep_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <TextView android:text="😴" android:textSize="16sp" android:layout_marginEnd="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/full_sleep_15" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="15m" android:textColor="#8b8b9e" android:textSize="12sp"
            android:padding="6dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/full_sleep_30" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="30m" android:textColor="#8b8b9e" android:textSize="12sp"
            android:padding="6dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/full_sleep_60" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="1h" android:textColor="#8b8b9e" android:textSize="12sp"
            android:padding="6dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/full_sleep_off" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Off" android:textColor="#e74c3c" android:textSize="12sp"
            android:padding="6dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
